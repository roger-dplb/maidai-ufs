# Copie para .env (na raiz do projeto) e preencha. Nunca faça commit do .env.
MAIDAI_BACKEND=openai
OPENAI_API_KEY=
# Opcionais (padrões entre parênteses)
# MAIDAI_OPENAI_MODELO=gpt-6-luna           (análise forense)
# MAIDAI_OPENAI_MODELO_VISAO=gpt-6-luna     (imagens; o mesmo da análise se vazio)
# MAIDAI_OPENAI_MODELO_AUDIO=whisper-1      (transcrição com timestamps)
# OPENAI_BASE_URL=                          (outro servidor compatível com a API da OpenAI)
